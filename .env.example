# Telegram API credentials — obtain from https://my.telegram.org
API_ID=
API_HASH=

# Telethon session string — generate with: python sv.py --gen-session
SESSION_STRING=

# Channel IDs (numeric, e.g. -100xxxxxxxxxx)
SOURCE_CHANNEL=
DESTINATION_CHANNEL=

# Optional — defaults shown
START_POST_ID=2
BATCH_SIZE=1000
DELAY=5
PAUSE_HOURS=3
MAX_RETRIES=3
